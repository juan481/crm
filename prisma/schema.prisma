generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────
enum Role {
  SUPER_ADMIN
  ADMIN
  SELLER
  HR
  TECHNICIAN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  PENDING_PAYMENT
  EXPIRED
  PROSPECT
}

enum ClientType {
  B2B
  B2C
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum NoteType {
  NOTE
  CALL
  EMAIL
  MEETING
  TASK
  CHAT
}

enum ActivityAction {
  NOTE
  CALL
  EMAIL
  MEETING
  TASK
  CLIENT_CREATED
  CLIENT_UPDATED
  CLIENT_DELETED
  STATUS_CHANGED
  SALE_REGISTERED
  DOCUMENT_UPLOADED
}

enum CampaignStatus {
  DRAFT
  SENDING
  SENT
  FAILED
}

enum RecipientStatus {
  pending
  sent
  failed
  bounced
  spam
  suppressed
}

enum DealStage {
  LEAD
  CONTACTADO
  PROPUESTA
  NEGOCIACION
  GANADO
  PERDIDO
}

enum TaskStatus {
  PENDIENTE
  EN_CURSO
  HECHA
}

enum Priority {
  BAJA
  MEDIA
  ALTA
  URGENTE
}

enum TicketStatus {
  ABIERTO
  EN_PROCESO
  ESPERANDO
  RESUELTO
  CERRADO
}

enum TicketCategory {
  SOPORTE
  BUG
  FACTURACION
  CONSULTA
}

enum EmpresaNotaTipo {
  NOTA
  LLAMADA
  REUNION
  CHAT
  ENVIO_COTIZACION
  CONVERSACION
  SOPORTE
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  ANNUAL
  ONE_TIME
}

enum CotizacionStatus {
  GUARDADA
  ENVIADA
  ACEPTADA
  RECHAZADA
  VENCIDA
}

enum SmtpProvider {
  SMTP
  SES
}

// ─── Multi-tenant White-label organizations ────────────────────────────────
model Organization {
  id             String   @id @default(cuid())
  name           String
  logoUrl        String?
  primaryColor   String   @default("#6366f1")
  secondaryColor String   @default("#8b5cf6")
  domain         String?  @unique
  crmName        String   @default("CRM Pro")
  // Rubro de la organización (ej. "seguridad", "marketing") — determina qué
  // módulos/plugins ve por defecto y qué tour de onboarding recibe. Lista
  // curada en src/lib/verticals.ts, a propósito NO es un enum de Prisma:
  // sumar un rubro nuevo no debe pedir migración. Null = todavía no eligió
  // (dispara el selector de "primera vez" para el SUPER_ADMIN, ver
  // POST /api/organization/vertical).
  vertical       String?
  quoteValidityDays Int   @default(30)
  smtpHost       String?
  smtpPort       Int?
  smtpUser       String?
  smtpPass       String?
  smtpFrom       String?
  smtpProvider   SmtpProvider @default(SMTP)
  sesRegion      String?
  sesAccessKeyId String?
  sesSecretKey   String?
  sesFrom        String?
  sesConfigSet   String?
  // Campaign-send cap. Agency-managed only — not exposed as an editable
  // field in any org-facing settings screen (see scripts/set-email-limit.ts).
  emailMonthlyLimit Int @default(9000)
  // Agency kill switch (e.g. non-payment). Blocks login for every user in
  // this org without deleting anything. Only ever changed from /admin —
  // never client-facing.
  suspended   Boolean   @default(false)
  suspendedAt DateTime?
  // Datos de facturación
  billingAddress      String?
  billingEmail        String?
  billingPhone        String?
  billingTaxId        String?
  paymentInstructions String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users          User[]
  clients        Client[]
  plugins        PluginConfig[]
  emailCampaigns EmailCampaign[]
  emailTemplates EmailTemplate[]
  services       Service[]
  products       Product[]
  events         Event[]
  folders        Folder[]
  documents      Document[]
  deals          Deal[]
  tasks          Task[]
  tickets        Ticket[]
  empresas          Empresa[]
  directorioContactos DirectorioContacto[]
  empresaNotas      EmpresaNota[]
  cotizaciones      Cotizacion[]
  asistencias       Asistencia[]
  suppressions      EmailSuppression[]
  emailUsage        EmailUsageMonthly[]
  memberships       OrganizationMembership[]
}

// Emails that opted out of marketing/campaign sends for an org. Checked before
// creating campaign recipients and again right before sending (in case someone
// unsubscribes while a large campaign is still batching out).
model EmailSuppression {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  reason         String   @default("unsubscribed")
  createdAt      DateTime @default(now())

  @@unique([organizationId, email])
  @@index([organizationId])
}

// Campaign-send volume per org per calendar month. Rows are created lazily on
// first send of a new month via upsert — this is the entire "reset"
// mechanism, no cron job needed. Only counts campaign sends (see
// src/lib/email-usage.ts) — quote emails and empresa-contact emails are
// explicitly excluded from this counter.
model EmailUsageMonthly {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  year           Int
  month          Int      // 1-12
  count          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, year, month])
  @@index([organizationId])
}

// ─── Users & Auth ──────────────────────────────────────────────────────────
model User {
  id                  String   @id @default(cuid())
  supabaseId          String?  @unique  // links to Supabase auth.users.id
  email               String   @unique
  name                String
  role                Role       @default(SELLER)
  status              UserStatus @default(ACTIVE)
  onboardingCompleted Boolean  @default(false)
  forcePasswordChange Boolean  @default(false)
  // Agency operator flag — orthogonal to Role (SUPER_ADMIN is per-org, this
  // is cross-tenant). Never settable from any in-app UI — only via
  // scripts/set-platform-admin.ts. See getPlatformAdmin() in src/lib/auth.ts.
  isPlatformAdmin     Boolean  @default(false)
  avatarUrl           String?
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([organizationId])

  notes          Note[]
  activityLogs   ActivityLog[]
  assignedClients Client[]     @relation("SellerClients")
  sales          Sale[]
  uploadedDocs   Document[]
  emailTemplates EmailTemplate[]
  ownedDeals     Deal[]        @relation("DealOwner")
  assignedTasks  Task[]        @relation("TaskAssignee")
  createdTasks   Task[]        @relation("TaskCreator")
  assignedTickets Ticket[]     @relation("TicketAssignee")
  createdTickets  Ticket[]     @relation("TicketCreator")
  ticketMessages  TicketMessage[] @relation("TicketMessageAuthor")
  taskComments    TaskComment[]
  empresaNotas    EmpresaNota[]
  cotizaciones    Cotizacion[]
  asistencias     Asistencia[]
  memberships     OrganizationMembership[]
}

// Session management is now handled by Supabase Auth

// Acceso ADICIONAL de un usuario a otra organización, aparte de la suya
// (User.organizationId/role, que sigue siendo su "organización de origen" y
// no cambia). Puramente aditivo — pensado para gente de la agencia (ej. el
// dueño) que necesita operar más de un tenant con el mismo login, sin crear
// una segunda cuenta de Supabase Auth. getCurrentUser() en src/lib/auth.ts
// revalida esta tabla en cada request antes de confiar en una organización
// distinta de la de origen — ver esa función para el mecanismo completo.
model OrganizationMembership {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           Role     @default(SUPER_ADMIN)
  createdAt      DateTime @default(now())

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
}

// ─── Services catalog ──────────────────────────────────────────────────────
model Service {
  id             String   @id @default(cuid())
  name           String
  description    String?
  price          Float    @default(0)
  currency       String   @default("USD")
  billingCycle   BillingCycle @default(MONTHLY)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clients        Client[]
  sales          Sale[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
}

// ─── Clients ───────────────────────────────────────────────────────────────
model Client {
  id             String   @id @default(cuid())
  name           String
  email          String
  phone          String?
  company        String?
  country        String?
  city           String?
  address        String?
  postalCode     String?
  province       String?
  website        String?
  status         ClientStatus @default(ACTIVE)
  isEnabled      Boolean      @default(true)
  clientType     ClientType   @default(B2B)
  serviceType    String?
  tags           String   @default("[]")
  mrr            Float    @default(0)
  contractStart  DateTime?
  contractEnd    DateTime?
  serviceId      String?
  service        Service?  @relation(fields: [serviceId], references: [id])
  // Licencia
  licenseSerial      String?
  licenseVersion     String?
  maxWorkstations    Int?
  subscriptionStart  DateTime?
  subscriptionEnd    DateTime?
  licenseHibernated  Boolean  @default(false)
  licenseRepurchased Boolean  @default(false)
  isActive24x7       Boolean  @default(false)
  // Comercial
  distributorName  String?
  totalInvestment  Float?
  renewalCount     Int      @default(0)
  assignedSellerId String?
  assignedSeller   User?    @relation("SellerClients", fields: [assignedSellerId], references: [id])
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  invoices     Invoice[]
  notes        Note[]
  activityLogs ActivityLog[]
  contacts     Contact[]
  sales        Sale[]
  documents    Document[]
  deals        Deal[]
  tasks        Task[]
  tickets      Ticket[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([status])
  @@index([clientType])
  @@index([assignedSellerId])
  @@index([serviceId])
}

model Contact {
  id        String  @id @default(cuid())
  name      String
  email     String?
  phone     String?
  whatsapp  String?
  role      String?
  clientId  String
  client    Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([clientId])
}

// ─── Invoices ──────────────────────────────────────────────────────────────
model Invoice {
  id             String   @id @default(cuid())
  // clientId (legacy) kept only for the old, no-longer-navigable /clients pages —
  // every invoice created from the live Facturación screen uses empresaId instead.
  clientId       String?
  client         Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  empresaId      String?
  empresa        Empresa? @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  organizationId String
  amount         Float
  currency       String   @default("USD")
  status         InvoiceStatus @default(PENDING)
  description    String?
  dueDate        DateTime
  paidAt         DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([clientId])
  @@index([empresaId])
  @@index([status])
  @@index([dueDate])
}

// ─── Timeline Notes ────────────────────────────────────────────────────────
model Note {
  id        String   @id @default(cuid())
  content   String
  type      NoteType @default(NOTE)
  metadata  String?  // JSON: { estimatedHours?, estimatedMinutes?, complexity?, estimatedCost?, imageUrl? }
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([clientId])
  @@index([userId])
}

// ─── Activity Log ──────────────────────────────────────────────────────────
model ActivityLog {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  action      ActivityAction @default(NOTE)
  description String
  metadata    String?
  createdAt   DateTime @default(now())

  @@index([clientId, createdAt])
}

// ─── Sales ─────────────────────────────────────────────────────────────────
model Sale {
  id         String   @id @default(cuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  sellerId   String
  seller     User     @relation(fields: [sellerId], references: [id])
  serviceId  String?
  service    Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  amount     Float
  currency   String   @default("USD")
  closedAt   DateTime @default(now())
  notes      String?
  createdAt  DateTime @default(now())

  @@index([sellerId])
  @@index([clientId])
}

// ─── Plugin System ─────────────────────────────────────────────────────────
model PluginConfig {
  id             String   @id @default(cuid())
  pluginId       String
  enabled        Boolean  @default(false)
  config         String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  updatedAt      DateTime @updatedAt

  @@unique([pluginId, organizationId])
}

// ─── Communications ────────────────────────────────────────────────────────
model EmailCampaign {
  id             String   @id @default(cuid())
  name           String
  subject        String
  body           String
  status         CampaignStatus @default(DRAFT)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sentAt         DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  // Tracking aggregates (populated by SES webhooks)
  totalDelivered Int      @default(0)
  totalBounced   Int      @default(0)
  totalSpam      Int      @default(0)
  totalOpened    Int      @default(0)

  recipients CampaignRecipient[]
}

model CampaignRecipient {
  id            String        @id @default(cuid())
  campaignId    String
  campaign      EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  email         String
  name          String?
  status        RecipientStatus @default(pending)
  sentAt        DateTime?
  error         String?
  // SES tracking fields
  messageId     String?
  deliveredAt   DateTime?
  bouncedAt     DateTime?
  bounceType    String?
  bounceSubType String?
  spamAt        DateTime?
  openedAt      DateTime?
  openCount     Int           @default(0)
}

// ─── Email Templates ───────────────────────────────────────────────────────
model EmailTemplate {
  id             String   @id @default(cuid())
  name           String
  subject        String
  body           String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById    String
  createdBy      User     @relation(fields: [createdById], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ─── Events ────────────────────────────────────────────────────────────────
model Event {
  id             String   @id @default(cuid())
  name           String
  description    String?
  eventDate      DateTime?
  location       String?
  isActive       Boolean  @default(true)
  webhookSecret  String   @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  attendees EventAttendee[]

  @@index([organizationId])
}

model EventAttendee {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  firstName String
  lastName  String
  company   String?
  phone     String?
  country   String?
  email     String?
  source    String   @default("manual")
  createdAt DateTime @default(now())

  @@index([eventId])
}

// ─── Document Repository ───────────────────────────────────────────────────
model Folder {
  id             String   @id @default(cuid())
  name           String
  parentId       String?
  parent         Folder?  @relation("FolderTree", fields: [parentId], references: [id])
  children       Folder[] @relation("FolderTree")
  clientId       String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documents      Document[]
  createdAt      DateTime @default(now())

  @@index([organizationId])
}

model Document {
  id             String   @id @default(cuid())
  name           String
  originalName   String
  mimeType       String
  size           Int
  url            String
  // Object path within the Supabase Storage bucket (ej. "documents/{orgId}/x.pdf")
  // — necesario para poder borrar el archivo real del storage al eliminar el
  // registro; `url` es la URL pública completa, no sirve para `.remove()`.
  // Nullable: filas viejas subidas antes de este campo no lo tienen.
  storagePath    String?
  folderId       String?
  folder         Folder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)
  clientId       String?
  client         Client?  @relation(fields: [clientId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tags           String   @default("[]")
  uploadedById   String
  uploadedBy     User     @relation(fields: [uploadedById], references: [id])
  createdAt      DateTime @default(now())

  // Versioning: uploading a "replacement" creates a new row pointing back at
  // the one it supersedes, instead of two unrelated documents with the same
  // display name. The document browser only lists the tip of each chain
  // (the one nothing else supersedes).
  // No DB-level unique constraint here on purpose (would need --accept-data-loss
  // for a fresh column with no possible duplicates yet) — the upload route
  // enforces "at most one row supersedes a given document" itself.
  version        Int       @default(1)
  supersedesId   String?
  supersedes     Document? @relation("DocumentVersions", fields: [supersedesId], references: [id])
  supersededBy   Document[] @relation("DocumentVersions")

  @@index([organizationId])
  @@index([clientId])
  @@index([supersedesId])
}

// ─── Sales Pipeline ────────────────────────────────────────────────────────
model Deal {
  id                String    @id @default(cuid())
  title             String
  amount            Float     @default(0)
  currency          String    @default("USD")
  probability       Int       @default(0)
  stage             DealStage @default(LEAD)
  expectedCloseDate DateTime?
  closedAt          DateTime?
  notes             String?
  clientId          String?
  client            Client?   @relation(fields: [clientId], references: [id])
  empresaId         String?
  empresa           Empresa?  @relation(fields: [empresaId], references: [id], onDelete: SetNull)
  ownerId           String
  owner             User      @relation("DealOwner", fields: [ownerId], references: [id])
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cotizaciones      Cotizacion[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([organizationId, stage])
  @@index([ownerId])
}

// ─── Tasks ─────────────────────────────────────────────────────────────────
model Task {
  id             String    @id @default(cuid())
  title          String
  description    String?
  status         TaskStatus @default(PENDIENTE)
  priority       Priority   @default(MEDIA)
  dueDate        DateTime?
  completedAt    DateTime?
  viewedAt       DateTime?
  assignedToId   String
  assignedTo     User      @relation("TaskAssignee", fields: [assignedToId], references: [id])
  createdById    String
  createdBy      User      @relation("TaskCreator", fields: [createdById], references: [id])
  clientId       String?
  client         Client?   @relation(fields: [clientId], references: [id])
  empresaId      String?
  empresa        Empresa?  @relation(fields: [empresaId], references: [id], onDelete: SetNull)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  comments       TaskComment[]
  subitems       TaskSubitem[]

  @@index([organizationId, status])
  @@index([assignedToId])
  @@index([empresaId])
}

model TaskSubitem {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title     String
  done      Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([taskId])
}

model TaskComment {
  id             String   @id @default(cuid())
  taskId         String
  task           Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  content        String
  attachmentUrl  String?
  attachmentName String?
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  createdAt      DateTime @default(now())

  @@index([taskId])
}

// ─── Support Tickets ───────────────────────────────────────────────────────
model Ticket {
  id             String    @id @default(cuid())
  number         Int
  title          String
  description    String
  status         TicketStatus   @default(ABIERTO)
  priority       Priority       @default(MEDIA)
  category       TicketCategory @default(SOPORTE)
  clientId       String?
  client         Client?   @relation(fields: [clientId], references: [id])
  empresaId      String?
  empresa        Empresa?  @relation(fields: [empresaId], references: [id], onDelete: SetNull)
  // Direct contact for client-facing notifications — independent of
  // Client/Empresa (which don't reliably carry a single contact email),
  // same pattern already used by Cotizacion.recipientEmail.
  recipientEmail String?
  recipientName  String?
  assignedToId   String?
  assignedTo     User?     @relation("TicketAssignee", fields: [assignedToId], references: [id])
  createdById    String
  createdBy      User      @relation("TicketCreator", fields: [createdById], references: [id])
  resolvedAt     DateTime?
  // SLA — calculado al crear (o al recategorizar prioridad mientras sigue
  // abierto) según Priority; ver SLA_HOURS en la API de tickets.
  slaDueAt              DateTime?
  // CSAT — link público de un solo uso, generado recién al cerrar/resolver
  // el ticket (no @default: evita requerir backfill en filas existentes).
  // Unicidad garantizada en la app (crypto.randomUUID), no a nivel de DB,
  // para evitar el flag --accept-data-loss en el push de este constraint.
  // No requiere login ni portal de cliente.
  satisfactionToken     String?
  satisfactionRating    Int?
  satisfactionComment   String?
  satisfactionRatedAt   DateTime?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages       TicketMessage[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([number, organizationId])
  @@index([organizationId, status])
  @@index([assignedToId])
  @@index([clientId])
  @@index([empresaId])
  @@index([satisfactionToken])
}

model TicketMessage {
  id             String   @id @default(cuid())
  ticketId       String
  ticket         Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  content        String
  isInternal     Boolean  @default(false)
  attachmentUrl  String?
  attachmentName String?
  userId         String
  user           User     @relation("TicketMessageAuthor", fields: [userId], references: [id])
  createdAt      DateTime @default(now())

  @@index([ticketId])
}

// ─── Directorio de Empresas y Técnicos ────────────────────────────────────
model Empresa {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  isCliente      Boolean  @default(false)
  clienteDesde   DateTime?
  activity       String?
  address        String?
  codigoPostal   String?
  city           String?
  province       String?
  country        String?
  website        String?
  // Recurring billing — only meaningful once isCliente=true. Powers
  // "Generar Facturas del Mes" (previously read from the legacy Client.mrr,
  // a table the live Clientes/Empresas workflow never populates).
  monthlyAmount    Float?
  billingCurrency  String   @default("USD")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  contactos      DirectorioContacto[]
  notas          EmpresaNota[]
  cotizaciones   Cotizacion[]
  deals          Deal[]
  tasks          Task[]
  tickets        Ticket[]
  invoices       Invoice[]

  @@index([organizationId])
  @@index([organizationId, name])
}

model DirectorioContacto {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  firstName      String
  lastName       String
  companyRaw     String?
  role           String?
  email          String?
  phone          String?
  empresaId      String?
  empresa        Empresa? @relation(fields: [empresaId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@index([empresaId])
  @@index([email])
}

// ─── Actividad / Notas de Empresa ─────────────────────────────────────────
model EmpresaNota {
  id               String   @id @default(cuid())
  empresaId        String
  empresa          Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  tipo             EmpresaNotaTipo @default(NOTA)
  content          String
  estimatedMinutes Int      @default(0)
  metadata         String?  // JSON: { imageUrl? }
  createdAt        DateTime @default(now())

  @@index([empresaId])
  @@index([organizationId])
}

// ─── Catálogo de Productos (venta única) ──────────────────────────────────
model Product {
  id             String   @id @default(cuid())
  name           String
  description    String?
  price          Float    @default(0)
  currency       String   @default("USD")
  unit           String   @default("unidad")
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
}

// ─── Historial de Cotizaciones ────────────────────────────────────────────
model Cotizacion {
  id             String    @id @default(cuid())
  ref            String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  empresaId      String?
  empresa        Empresa?  @relation(fields: [empresaId], references: [id], onDelete: SetNull)
  // Vínculo estructurado a la oportunidad de Pipeline que originó (o recibió)
  // esta cotización — antes solo existía como texto libre en Deal.notes.
  dealId         String?
  deal           Deal?     @relation(fields: [dealId], references: [id], onDelete: SetNull)
  recipientEmail String
  recipientName  String
  items          Json
  total          Float
  discount       Float     @default(0)
  finalTotal     Float     @default(0)
  currency       String    @default("USD")
  notes          String?
  validityDays   Int       @default(30)
  status         CotizacionStatus @default(ENVIADA)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId])
  @@index([empresaId])
  @@index([userId])
  @@index([dealId])
}

// ─── Módulo RRHH: Asistencia ──────────────────────────────────────────────
model Asistencia {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fecha          DateTime  @db.Date
  horaEntrada    DateTime?
  horaSalida     DateTime?
  ausente        Boolean   @default(false)
  tardanza       Boolean   @default(false)
  observaciones  String?
  creadoPorId    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([userId, fecha, organizationId])
  @@index([organizationId])
  @@index([userId])
  @@index([fecha])
}
