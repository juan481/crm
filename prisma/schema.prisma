generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────
enum Role {
  SUPER_ADMIN
  ADMIN
  SELLER
  HR
  TECHNICIAN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  PENDING_PAYMENT
  EXPIRED
  PROSPECT
}

enum ClientType {
  B2B
  B2C
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum NoteType {
  NOTE
  CALL
  EMAIL
  MEETING
  TASK
  CHAT
}

enum ActivityAction {
  NOTE
  CALL
  EMAIL
  MEETING
  TASK
  CLIENT_CREATED
  CLIENT_UPDATED
  CLIENT_DELETED
  STATUS_CHANGED
  SALE_REGISTERED
  DOCUMENT_UPLOADED
}

enum CampaignStatus {
  DRAFT
  SENDING
  SENT
  FAILED
}

enum RecipientStatus {
  pending
  // Estado transitorio: "reclamado" por un request de envío en curso, antes
  // de que termine de mandar el email. Ver claim atómico en
  // campaigns/[id]/send/route.ts — sin esto, dos requests concurrentes
  // (dos pestañas, doble click en "Reenviar pendientes") podían leer el
  // mismo batch de `pending` y mandar el mismo email dos veces,
  // descontando cupo dos veces.
  sending
  sent
  failed
  bounced
  spam
  suppressed
}

enum DealStage {
  LEAD
  CONTACTADO
  PROPUESTA
  NEGOCIACION
  GANADO
  PERDIDO
}

enum TaskStatus {
  PENDIENTE
  EN_CURSO
  HECHA
}

enum Priority {
  BAJA
  MEDIA
  ALTA
  URGENTE
}

enum TicketStatus {
  ABIERTO
  EN_PROCESO
  ESPERANDO
  RESUELTO
  CERRADO
}

enum TicketCategory {
  SOPORTE
  BUG
  FACTURACION
  CONSULTA
}

enum EmpresaNotaTipo {
  NOTA
  LLAMADA
  REUNION
  CHAT
  ENVIO_COTIZACION
  CONVERSACION
  SOPORTE
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  ANNUAL
  ONE_TIME
}

enum CotizacionStatus {
  GUARDADA
  ENVIADA
  ACEPTADA
  RECHAZADA
  VENCIDA
}

enum SmtpProvider {
  SMTP
  SES
}

// ─── Multi-tenant White-label organizations ────────────────────────────────
model Organization {
  id                         String       @id @default(cuid())
  name                       String
  logoUrl                    String?
  primaryColor               String       @default("#6366f1")
  secondaryColor             String       @default("#8b5cf6")
  domain                     String?      @unique
  crmName                    String       @default("CRM Pro")
  // Rubro de la organización (ej. "seguridad", "marketing") — determina qué
  // módulos/plugins ve por defecto y qué tour de onboarding recibe. Lista
  // curada en src/lib/verticals.ts, a propósito NO es un enum de Prisma:
  // sumar un rubro nuevo no debe pedir migración. Null = todavía no eligió
  // (dispara el selector de "primera vez" para el SUPER_ADMIN, ver
  // POST /api/organization/vertical).
  vertical                   String?
  // Token del formulario público de autogestión de tickets
  // (/soporte/[token]) — mismo espíritu que Event.webhookSecret (línea 578)
  // pero nullable a propósito: un ALTER TABLE que agrega una columna NOT
  // NULL (con o sin @unique) contra una tabla con filas existentes no tiene
  // un valor por default expresable en SQL puro para cuid() — Postgres
  // rechaza esa migración de plano contra la base compartida de producción.
  // Se resuelve en dos pasos: nullable acá + backfill por script
  // (scripts/tmp-backfill-support-token.ts) para las orgs ya existentes;
  // toda organización NUEVA sí recibe un token automático (default a nivel
  // Prisma Client, no a nivel SQL). Los API routes tratan null = "todavía
  // sin token" y lo resuelven on-demand si hiciera falta.
  publicSupportToken         String?      @default(cuid())
  quoteValidityDays          Int          @default(30)
  // Horario laboral para el cálculo de tardanza en Asistencia — antes esto
  // estaba hardcodeado a las 09:15 en el código (09:00 + 15 min), fijo para
  // toda organización sin importar su horario real. "HH:MM" en texto simple
  // (no un tipo Time de Postgres) para no pelear con conversión de huso
  // horario en Prisma; se parsea a mano en check-in. Configurable por HR o
  // superior desde RRHH — no requiere Configuración general.
  attendanceStartTime        String       @default("09:00")
  attendanceToleranceMinutes Int          @default(15)
  smtpHost                   String?
  smtpPort                   Int?
  smtpUser                   String?
  smtpPass                   String?
  smtpFrom                   String?
  smtpProvider               SmtpProvider @default(SMTP)
  sesRegion                  String?
  sesAccessKeyId             String?
  sesSecretKey               String?
  sesFrom                    String?
  sesConfigSet               String?
  // Campaign-send cap. Agency-managed only — not exposed as an editable
  // field in any org-facing settings screen (see scripts/set-email-limit.ts).
  emailMonthlyLimit          Int          @default(9000)
  // Agency kill switch (e.g. non-payment). Blocks login for every user in
  // this org without deleting anything. Only ever changed from /admin —
  // never client-facing.
  suspended                  Boolean      @default(false)
  suspendedAt                DateTime?
  // Datos de facturación
  billingAddress             String?
  billingEmail               String?
  billingPhone               String?
  billingTaxId               String?
  paymentInstructions        String?
  createdAt                  DateTime     @default(now())
  updatedAt                  DateTime     @updatedAt

  users                   User[]
  clients                 Client[]
  plugins                 PluginConfig[]
  modulePermissions       ModulePermission[]
  whatsAppConversations   WhatsAppConversation[]
  emailCampaigns          EmailCampaign[]
  emailTemplates          EmailTemplate[]
  services                Service[]
  products                Product[]
  stockMovimientos        StockMovimiento[]
  quickActionUsage        QuickActionUsage[]
  events                  Event[]
  folders                 Folder[]
  documents               Document[]
  deals                   Deal[]
  tasks                   Task[]
  tickets                 Ticket[]
  empresas                Empresa[]
  directorioContactos     DirectorioContacto[]
  empresaNotas            EmpresaNota[]
  dealNotas               DealNota[]
  directorioContactoNotas DirectorioContactoNota[]
  cotizaciones            Cotizacion[]
  asistencias             Asistencia[]
  loginEvents             LoginEvent[]
  turnosAsistencia        TurnoAsistencia[]
  suppressions            EmailSuppression[]
  emailUsage              EmailUsageMonthly[]
  memberships             OrganizationMembership[]
}

// Emails that opted out of marketing/campaign sends for an org. Checked before
// creating campaign recipients and again right before sending (in case someone
// unsubscribes while a large campaign is still batching out).
model EmailSuppression {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  reason         String       @default("unsubscribed")
  createdAt      DateTime     @default(now())

  @@unique([organizationId, email])
  @@index([organizationId])
}

// Campaign-send volume per org per calendar month. Rows are created lazily on
// first send of a new month via upsert — this is the entire "reset"
// mechanism, no cron job needed. Only counts campaign sends (see
// src/lib/email-usage.ts) — quote emails and empresa-contact emails are
// explicitly excluded from this counter.
model EmailUsageMonthly {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  year           Int
  month          Int // 1-12
  count          Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, year, month])
  @@index([organizationId])
}

// ─── Users & Auth ──────────────────────────────────────────────────────────
model User {
  id                  String       @id @default(cuid())
  supabaseId          String?      @unique // links to Supabase auth.users.id
  email               String       @unique
  name                String
  role                Role         @default(SELLER)
  status              UserStatus   @default(ACTIVE)
  onboardingCompleted Boolean      @default(false)
  forcePasswordChange Boolean      @default(false)
  // Agency operator flag — orthogonal to Role (SUPER_ADMIN is per-org, this
  // is cross-tenant). Never settable from any in-app UI — only via
  // scripts/set-platform-admin.ts. See getPlatformAdmin() in src/lib/auth.ts.
  isPlatformAdmin     Boolean      @default(false)
  avatarUrl           String?
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  notes                   Note[]
  activityLogs            ActivityLog[]
  assignedClients         Client[]                 @relation("SellerClients")
  sales                   Sale[]
  uploadedDocs            Document[]
  emailTemplates          EmailTemplate[]
  ownedDeals              Deal[]                   @relation("DealOwner")
  ownedEmpresas           Empresa[]                @relation("EmpresaOwner")
  assignedTasks           Task[]                   @relation("TaskAssignee")
  createdTasks            Task[]                   @relation("TaskCreator")
  taskCollaborations      TaskCollaborator[]
  assignedTickets         Ticket[]                 @relation("TicketAssignee")
  createdTickets          Ticket[]                 @relation("TicketCreator")
  ticketCollaborations    TicketCollaborator[]
  ticketMessages          TicketMessage[]          @relation("TicketMessageAuthor")
  taskComments            TaskComment[]
  empresaNotas            EmpresaNota[]
  dealNotas               DealNota[]
  directorioContactoNotas DirectorioContactoNota[]
  cotizaciones            Cotizacion[]
  asistencias             Asistencia[]
  loginEvents             LoginEvent[]
  turnosAsistencia        TurnoAsistencia[]
  quickActionUsage        QuickActionUsage[]
  memberships             OrganizationMembership[]

  @@index([organizationId])
}

// Session management is now handled by Supabase Auth

// Acceso ADICIONAL de un usuario a otra organización, aparte de la suya
// (User.organizationId/role, que sigue siendo su "organización de origen" y
// no cambia). Puramente aditivo — pensado para gente de la agencia (ej. el
// dueño) que necesita operar más de un tenant con el mismo login, sin crear
// una segunda cuenta de Supabase Auth. getCurrentUser() en src/lib/auth.ts
// revalida esta tabla en cada request antes de confiar en una organización
// distinta de la de origen — ver esa función para el mecanismo completo.
model OrganizationMembership {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           Role         @default(SUPER_ADMIN)
  createdAt      DateTime     @default(now())

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
}

// ─── Services catalog ──────────────────────────────────────────────────────
model Service {
  id             String       @id @default(cuid())
  name           String
  description    String?
  price          Float        @default(0)
  currency       String       @default("USD")
  billingCycle   BillingCycle @default(MONTHLY)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clients        Client[]
  sales          Sale[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

// ─── Clients ───────────────────────────────────────────────────────────────
model Client {
  id                 String       @id @default(cuid())
  name               String
  email              String
  phone              String?
  company            String?
  country            String?
  city               String?
  address            String?
  postalCode         String?
  province           String?
  website            String?
  status             ClientStatus @default(ACTIVE)
  isEnabled          Boolean      @default(true)
  clientType         ClientType   @default(B2B)
  serviceType        String?
  tags               String       @default("[]")
  mrr                Float        @default(0)
  contractStart      DateTime?
  contractEnd        DateTime?
  serviceId          String?
  service            Service?     @relation(fields: [serviceId], references: [id])
  // Licencia
  licenseSerial      String?
  licenseVersion     String?
  maxWorkstations    Int?
  subscriptionStart  DateTime?
  subscriptionEnd    DateTime?
  licenseHibernated  Boolean      @default(false)
  licenseRepurchased Boolean      @default(false)
  isActive24x7       Boolean      @default(false)
  // Comercial
  distributorName    String?
  totalInvestment    Float?
  renewalCount       Int          @default(0)
  assignedSellerId   String?
  assignedSeller     User?        @relation("SellerClients", fields: [assignedSellerId], references: [id])
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  invoices     Invoice[]
  notes        Note[]
  activityLogs ActivityLog[]
  contacts     Contact[]
  sales        Sale[]
  documents    Document[]
  deals        Deal[]
  tasks        Task[]
  tickets      Ticket[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([status])
  @@index([clientType])
  @@index([assignedSellerId])
  @@index([serviceId])
}

model Contact {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  whatsapp  String?
  role      String?
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([clientId])
}

// ─── Invoices ──────────────────────────────────────────────────────────────
model Invoice {
  id             String        @id @default(cuid())
  // clientId (legacy) kept only for the old, no-longer-navigable /clients pages —
  // every invoice created from the live Facturación screen uses empresaId instead.
  clientId       String?
  client         Client?       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  empresaId      String?
  empresa        Empresa?      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  organizationId String
  amount         Float
  currency       String        @default("USD")
  status         InvoiceStatus @default(PENDING)
  description    String?
  dueDate        DateTime
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId])
  @@index([organizationId, status])
  // Cubre el where real de "cobrado este mes" (status=PAID + paidAt>=inicio
  // de mes) que emite GET /api/invoices — antes ninguna combinación de
  // índices cubría el filtro por paidAt.
  @@index([organizationId, status, paidAt])
  @@index([clientId])
  @@index([empresaId])
  // Cubre el filtro por empresa que ya usa la UI de Facturación.
  @@index([organizationId, empresaId])
  @@index([status])
  @@index([dueDate])
}

// ─── Timeline Notes ────────────────────────────────────────────────────────
model Note {
  id        String   @id @default(cuid())
  content   String
  type      NoteType @default(NOTE)
  metadata  String? // JSON: { estimatedHours?, estimatedMinutes?, complexity?, estimatedCost?, imageUrl? }
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([clientId])
  @@index([userId])
}

// ─── Activity Log ──────────────────────────────────────────────────────────
model ActivityLog {
  id          String         @id @default(cuid())
  clientId    String
  client      Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId      String
  user        User           @relation(fields: [userId], references: [id])
  action      ActivityAction @default(NOTE)
  description String
  metadata    String?
  createdAt   DateTime       @default(now())

  @@index([clientId, createdAt])
}

// ─── Sales ─────────────────────────────────────────────────────────────────
model Sale {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  sellerId  String
  seller    User     @relation(fields: [sellerId], references: [id])
  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  amount    Float
  currency  String   @default("USD")
  closedAt  DateTime @default(now())
  notes     String?
  createdAt DateTime @default(now())

  @@index([sellerId])
  @@index([clientId])
}

// ─── Plugin System ─────────────────────────────────────────────────────────
model PluginConfig {
  id             String       @id @default(cuid())
  pluginId       String
  enabled        Boolean      @default(false)
  config         String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  updatedAt      DateTime     @updatedAt

  @@unique([pluginId, organizationId])
}

// Visibilidad de nav configurable por rol (Configuración > Gestión de
// Usuarios > Permisos). Aditivo/restrictivo sobre canAccess() — nunca lo
// reemplaza: el endpoint que escribe esta tabla rechaza habilitar un módulo
// para un rol que no supera el piso real de canAccess() en las rutas de ese
// módulo (ver src/lib/modules.ts). Sin fila = usa el default declarado en
// MODULE_DEFINITIONS (así una org sin ninguna fila acá se comporta
// exactamente igual que antes de que existiera esta tabla).
model ModulePermission {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  moduleId       String
  role           Role
  enabled        Boolean      @default(true)
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, moduleId, role])
  @@index([organizationId])
}

// ─── Bot de WhatsApp con IA ("NISSI" para Abba, genérico para cualquier org)
// Plugin whatsapp-ai-bot (ver src/plugins/definitions.ts) — separado a
// propósito del plugin whatsapp-integration (que sólo manda mensajes salientes
// desde la ficha de contacto): son features independientes que una org puede
// activar por separado, aunque en la práctica compartan el mismo número.
enum WhatsAppConversationStatus {
  ACTIVE // la IA sigue respondiendo
  HANDED_OFF // se derivó a un humano (ticket o deal creado) — la IA no vuelve a responder sola
  CLOSED // conversación inactiva, se retoma desde cero si el cliente vuelve a escribir
}

model WhatsAppConversation {
  id             String                     @id @default(cuid())
  organizationId String
  organization   Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // phone_number_id de Meta que recibió el mensaje — el webhook es UNO SOLO
  // compartido por todas las organizaciones (así lo pide la Cloud API), este
  // campo es lo único que permite saber a qué organización pertenece cada
  // mensaje entrante. Ver resolveOrgByPhoneNumberId en src/lib/whatsapp-bot.
  phoneNumberId  String
  // wa_id del cliente final (E.164 sin "+"), no un id nuestro.
  customerPhone  String
  customerName   String?
  status         WhatsAppConversationStatus @default(ACTIVE)
  // Todo lo que la IA fue completando durante la charla (nombre, mail,
  // dirección, filtro de ventas/técnico respondido, etc.) — Json en vez de
  // columnas fijas porque el cuestionario de Abba todavía tiene huecos sin
  // cerrar (ver memoria abba-bot-whatsapp-ia-spec) y el set de datos va a
  // seguir cambiando sin pedir una migración cada vez.
  collectedData  Json?
  // A quién se derivó ('VENTAS' | 'SOPORTE' | 'ADMINISTRACION'), sólo texto
  // libre para mostrar en el CRM — no gobierna ninguna lógica por sí solo.
  handedOffTo    String?
  ticketId       String?
  dealId         String?
  lastMessageAt  DateTime                   @default(now())
  createdAt      DateTime                   @default(now())
  messages       WhatsAppMessage[]

  @@unique([organizationId, customerPhone])
  @@index([organizationId, status])
  @@index([phoneNumberId])
}

model WhatsAppMessage {
  id             String               @id @default(cuid())
  conversationId String
  conversation   WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  // 'user' | 'assistant' — mismo vocabulario que la Messages API de
  // Anthropic, se reconstruye el historial mandándolo tal cual.
  role           String
  content        String               @db.Text
  // Id de Meta en mensajes entrantes — evita procesar el mismo webhook dos
  // veces si Meta reintenta la entrega (pasa seguido). Null en los mensajes
  // que genera la IA (salen de acá hacia Meta, no al revés).
  waMessageId    String?              @unique
  createdAt      DateTime             @default(now())

  @@index([conversationId, createdAt])
}

// ─── Communications ────────────────────────────────────────────────────────
model EmailCampaign {
  id             String         @id @default(cuid())
  name           String
  subject        String
  body           String
  status         CampaignStatus @default(DRAFT)
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sentAt         DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  // Tracking aggregates (populated by SES webhooks)
  totalDelivered Int            @default(0)
  totalBounced   Int            @default(0)
  totalSpam      Int            @default(0)
  totalOpened    Int            @default(0)

  recipients CampaignRecipient[]
}

model CampaignRecipient {
  id            String          @id @default(cuid())
  campaignId    String
  campaign      EmailCampaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  email         String
  name          String?
  status        RecipientStatus @default(pending)
  sentAt        DateTime?
  error         String?
  // SES tracking fields
  messageId     String?
  deliveredAt   DateTime?
  bouncedAt     DateTime?
  bounceType    String?
  bounceSubType String?
  spamAt        DateTime?
  openedAt      DateTime?
  openCount     Int             @default(0)
  // Necesario para detectar filas "sending" abandonadas por un request que
  // murió a mitad de camino (ver auto-recuperación en
  // campaigns/[id]/send/route.ts) — se actualiza solo en cada UPDATE,
  // incluido el propio claim atómico, así que marca el momento exacto en
  // que se reclamó la fila.
  updatedAt     DateTime        @default(now()) @updatedAt
}

// ─── Email Templates ───────────────────────────────────────────────────────
model EmailTemplate {
  id             String       @id @default(cuid())
  name           String
  subject        String
  body           String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById    String
  createdBy      User         @relation(fields: [createdById], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// ─── Events ────────────────────────────────────────────────────────────────
model Event {
  id             String       @id @default(cuid())
  name           String
  description    String?
  eventDate      DateTime?
  location       String?
  isActive       Boolean      @default(true)
  webhookSecret  String       @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  attendees EventAttendee[]

  @@index([organizationId])
}

model EventAttendee {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  firstName String
  lastName  String
  company   String?
  phone     String?
  country   String?
  email     String?
  source    String   @default("manual")
  createdAt DateTime @default(now())

  @@index([eventId])
}

// ─── Document Repository ───────────────────────────────────────────────────
model Folder {
  id             String       @id @default(cuid())
  name           String
  parentId       String?
  parent         Folder?      @relation("FolderTree", fields: [parentId], references: [id])
  children       Folder[]     @relation("FolderTree")
  clientId       String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documents      Document[]
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

model Document {
  id             String       @id @default(cuid())
  name           String
  originalName   String
  mimeType       String
  size           Int
  url            String
  // Object path within the Supabase Storage bucket (ej. "documents/{orgId}/x.pdf")
  // — necesario para poder borrar el archivo real del storage al eliminar el
  // registro; `url` es la URL pública completa, no sirve para `.remove()`.
  // Nullable: filas viejas subidas antes de este campo no lo tienen.
  storagePath    String?
  folderId       String?
  folder         Folder?      @relation(fields: [folderId], references: [id], onDelete: SetNull)
  clientId       String?
  client         Client?      @relation(fields: [clientId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tags           String       @default("[]")
  uploadedById   String
  uploadedBy     User         @relation(fields: [uploadedById], references: [id])
  createdAt      DateTime     @default(now())

  // Versioning: uploading a "replacement" creates a new row pointing back at
  // the one it supersedes, instead of two unrelated documents with the same
  // display name. The document browser only lists the tip of each chain
  // (the one nothing else supersedes).
  // @@unique([supersedesId]) — antes esto dependía 100% de un find-then-create
  // en la app (upload/route.ts: lee supersededBy, si está vacío crea la nueva
  // versión) sin protección transaccional: dos reemplazos casi simultáneos
  // del mismo documento (doble click, o dos personas subiendo la versión
  // nueva a la vez) podían leer ambos "sin versión más nueva" y crear dos
  // filas superseding el mismo original — las dos aparecían como "versión
  // vigente" en el listado. NULL no cuenta para el unique (Postgres permite
  // múltiples filas con supersedesId=NULL), así que esto sólo impide DOS
  // documentos apuntando al MISMO original — exactamente la garantía que
  // faltaba. Verificado antes de aplicar: cero duplicados ya existentes en
  // producción.
  version      Int        @default(1)
  supersedesId String?    @unique
  supersedes   Document?  @relation("DocumentVersions", fields: [supersedesId], references: [id])
  supersededBy Document[] @relation("DocumentVersions")

  @@index([organizationId])
  @@index([clientId])
  @@index([supersedesId])
}

// ─── Sales Pipeline ────────────────────────────────────────────────────────
model Deal {
  id                String       @id @default(cuid())
  title             String
  amount            Float        @default(0)
  currency          String       @default("USD")
  probability       Int          @default(0)
  stage             DealStage    @default(LEAD)
  expectedCloseDate DateTime?
  closedAt          DateTime?
  notes             String?
  // Fuente estructurada del lead ('WHATSAPP' | 'MANUAL' | futuras — string
  // libre, mismo criterio que Organization.vertical/Empresa.condicionIva: no
  // amerita enum de Prisma porque sumar una fuente nueva no debe pedir
  // migración. null = alta manual anterior a este campo.
  origen            String?
  clientId          String?
  client            Client?      @relation(fields: [clientId], references: [id])
  empresaId         String?
  empresa           Empresa?     @relation(fields: [empresaId], references: [id], onDelete: SetNull)
  ownerId           String
  owner             User         @relation("DealOwner", fields: [ownerId], references: [id])
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cotizaciones      Cotizacion[]
  notas             DealNota[]
  tasks             Task[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([organizationId, stage])
  @@index([ownerId])
}

// ─── Actividad / Notas de Deal ─────────────────────────────────────────────
// Mismo shape que EmpresaNota (mismo enum EmpresaNotaTipo, aplica igual de
// bien a una oportunidad) — timeline de llamadas/reuniones/etc. de un Deal,
// separado del campo Deal.notes (que queda como descripción corta, igual
// que Empresa.activity convive con EmpresaNota[]).
model DealNota {
  id               String          @id @default(cuid())
  dealId           String
  deal             Deal            @relation(fields: [dealId], references: [id], onDelete: Cascade)
  organizationId   String
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId           String
  user             User            @relation(fields: [userId], references: [id])
  tipo             EmpresaNotaTipo @default(NOTA)
  content          String
  estimatedMinutes Int             @default(0)
  metadata         String? // JSON: { imageUrl? }
  createdAt        DateTime        @default(now())

  @@index([dealId])
  @@index([organizationId])
}

// ─── Tasks ─────────────────────────────────────────────────────────────────
model Task {
  id             String             @id @default(cuid())
  title          String
  description    String?
  status         TaskStatus         @default(PENDIENTE)
  priority       Priority           @default(MEDIA)
  dueDate        DateTime?
  completedAt    DateTime?
  viewedAt       DateTime?
  assignedToId   String
  assignedTo     User               @relation("TaskAssignee", fields: [assignedToId], references: [id])
  createdById    String
  createdBy      User               @relation("TaskCreator", fields: [createdById], references: [id])
  clientId       String?
  client         Client?            @relation(fields: [clientId], references: [id])
  empresaId      String?
  empresa        Empresa?           @relation(fields: [empresaId], references: [id], onDelete: SetNull)
  // Vínculo opcional a una oportunidad de Pipeline o a un Ticket — mismo
  // criterio que empresaId (nullable, onDelete: SetNull, no rompe nada si
  // se borra el Deal/Ticket de origen). Ver Fase 11 del plan.
  dealId         String?
  deal           Deal?              @relation(fields: [dealId], references: [id], onDelete: SetNull)
  ticketId       String?
  ticket         Ticket?            @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  comments       TaskComment[]
  subitems       TaskSubitem[]
  // Colaboradores ADEMÁS del asignado principal (assignedToId) — no es
  // obligatorio, la mayoría de las tareas van a seguir teniendo sólo el
  // asignado de siempre. assignedToId sigue siendo la fuente de verdad
  // para todo lo que ya existía (permisos, notificación de asignación,
  // "Mi Día", el digest diario) — esto es puramente aditivo, ver
  // TaskCollaborator.
  collaborators  TaskCollaborator[]

  @@index([organizationId, status])
  // Cubre el where real que emite GET /api/tareas para SELLER/TECHNICIAN/HR
  // (organizationId + assignedToId juntos) — antes sólo había índices de
  // una sola columna, ninguno cubriendo la combinación exacta.
  @@index([organizationId, assignedToId])
  @@index([assignedToId])
  @@index([empresaId])
  @@index([dealId])
  @@index([ticketId])
}

// Colaborador adicional de una Tarea — join table explícita (no relación
// implícita m2m) para que quede un id propio y quede simple borrar/listar
// desde la app. assignedToId en Task sigue siendo el "dueño" principal;
// esto es gente que además está en el loop, con los mismos permisos que
// el asignado principal para ver/actualizar la tarea (ver GET/PATCH
// /api/tareas). Un mismo usuario no puede estar dos veces en la misma
// tarea (@@unique).
model TaskCollaborator {
  id         String   @id @default(cuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@unique([taskId, userId])
  @@index([userId])
}

model TaskSubitem {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title     String
  done      Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([taskId])
}

model TaskComment {
  id             String   @id @default(cuid())
  taskId         String
  task           Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  content        String
  attachmentUrl  String?
  attachmentName String?
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  createdAt      DateTime @default(now())

  @@index([taskId])
}

// ─── Support Tickets ───────────────────────────────────────────────────────
model Ticket {
  id                  String               @id @default(cuid())
  number              Int
  title               String
  description         String
  status              TicketStatus         @default(ABIERTO)
  priority            Priority             @default(MEDIA)
  category            TicketCategory       @default(SOPORTE)
  clientId            String?
  client              Client?              @relation(fields: [clientId], references: [id])
  empresaId           String?
  empresa             Empresa?             @relation(fields: [empresaId], references: [id], onDelete: SetNull)
  // Direct contact for client-facing notifications — independent of
  // Client/Empresa (which don't reliably carry a single contact email),
  // same pattern already used by Cotizacion.recipientEmail.
  recipientEmail      String?
  recipientName       String?
  assignedToId        String?
  assignedTo          User?                @relation("TicketAssignee", fields: [assignedToId], references: [id])
  createdById         String
  createdBy           User                 @relation("TicketCreator", fields: [createdById], references: [id])
  resolvedAt          DateTime?
  // SLA — calculado al crear (o al recategorizar prioridad mientras sigue
  // abierto) según Priority; ver SLA_HOURS en la API de tickets.
  slaDueAt            DateTime?
  // CSAT — link público de un solo uso, generado recién al cerrar/resolver
  // el ticket (no @default: evita requerir backfill en filas existentes).
  // Unicidad garantizada en la app (crypto.randomUUID), no a nivel de DB,
  // para evitar el flag --accept-data-loss en el push de este constraint.
  // No requiere login ni portal de cliente.
  satisfactionToken   String?
  satisfactionRating  Int?
  satisfactionComment String?
  satisfactionRatedAt DateTime?
  organizationId      String
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages            TicketMessage[]
  tasks               Task[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  // Mismo criterio que Task.collaborators — ver TicketCollaborator.
  collaborators       TicketCollaborator[]

  @@unique([number, organizationId])
  @@index([organizationId, status])
  @@index([assignedToId])
  @@index([clientId])
  @@index([empresaId])
  @@index([satisfactionToken])
}

// Mismo patrón que TaskCollaborator — ver ese comentario.
model TicketCollaborator {
  id         String   @id @default(cuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@unique([ticketId, userId])
  @@index([userId])
}

model TicketMessage {
  id             String   @id @default(cuid())
  ticketId       String
  ticket         Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  content        String
  isInternal     Boolean  @default(false)
  attachmentUrl  String?
  attachmentName String?
  userId         String
  user           User     @relation("TicketMessageAuthor", fields: [userId], references: [id])
  createdAt      DateTime @default(now())

  @@index([ticketId])
}

// ─── Directorio de Empresas y Técnicos ────────────────────────────────────
model Empresa {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name              String
  isCliente         Boolean      @default(false)
  clienteDesde      DateTime?
  activity          String?
  address           String?
  codigoPostal      String?
  city              String?
  province          String?
  country           String?
  website           String?
  // Recurring billing — only meaningful once isCliente=true. Powers
  // "Generar Facturas del Mes" (previously read from the legacy Client.mrr,
  // a table the live Clientes/Empresas workflow never populates).
  monthlyAmount     Float?
  billingCurrency   String       @default("USD")
  // Datos fiscales (AR) — texto libre en vez de enum de Prisma a propósito,
  // mismo criterio que país/ciudad más arriba: una lista de categorías (IVA,
  // formas de pago) puede cambiar sin pedir una migración de schema. Ver
  // src/lib/fiscal.ts para las listas curadas que alimentan el <select> del
  // formulario.
  cuit              String?
  condicionIva      String?
  formaPagoHabitual String?
  // Cartera de Ventas — reparto de trabajo, NO aislamiento de datos (eso
  // sigue siendo organizationId exclusivamente). Nullable: una empresa sin
  // dueño asignado sigue viendo todo el resto del sistema igual que hoy.
  ownerId           String?
  owner             User?        @relation("EmpresaOwner", fields: [ownerId], references: [id])
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  contactos    DirectorioContacto[]
  notas        EmpresaNota[]
  cotizaciones Cotizacion[]
  deals        Deal[]
  tasks        Task[]
  tickets      Ticket[]
  invoices     Invoice[]

  @@index([organizationId])
  @@index([organizationId, name])
  @@index([organizationId, ownerId])
}

model DirectorioContacto {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  firstName      String
  lastName       String
  companyRaw     String?
  role           String?
  email          String?
  phone          String?
  empresaId      String?
  empresa        Empresa?     @relation(fields: [empresaId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  notas DirectorioContactoNota[]

  @@index([organizationId])
  @@index([empresaId])
  @@index([email])
}

// ─── Actividad / Notas de Empresa ─────────────────────────────────────────
model EmpresaNota {
  id               String          @id @default(cuid())
  empresaId        String
  empresa          Empresa         @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  organizationId   String
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId           String
  user             User            @relation(fields: [userId], references: [id])
  tipo             EmpresaNotaTipo @default(NOTA)
  content          String
  estimatedMinutes Int             @default(0)
  metadata         String? // JSON: { imageUrl? }
  createdAt        DateTime        @default(now())

  @@index([empresaId])
  @@index([organizationId])
}

// ─── Actividad / Notas de Contacto (Directorio) ────────────────────────────
// Mismo patrón que EmpresaNota/DealNota — historial propio de un contacto,
// independiente del de su Empresa vinculada (un contacto puede cambiar de
// empresa sin perder su propio historial).
model DirectorioContactoNota {
  id               String             @id @default(cuid())
  contactoId       String
  contacto         DirectorioContacto @relation(fields: [contactoId], references: [id], onDelete: Cascade)
  organizationId   String
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId           String
  user             User               @relation(fields: [userId], references: [id])
  tipo             EmpresaNotaTipo    @default(NOTA)
  content          String
  estimatedMinutes Int                @default(0)
  metadata         String? // JSON: { imageUrl? }
  createdAt        DateTime           @default(now())

  @@index([contactoId])
  @@index([organizationId])
}

// ─── Catálogo de Productos (venta única) ──────────────────────────────────
model Product {
  id             String            @id @default(cuid())
  name           String
  description    String?
  price          Float             @default(0)
  currency       String            @default("USD")
  unit           String            @default("unidad")
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Stock — opt-in por producto (default false) para que ningún producto ya
  // cargado hoy pase a mostrar "0 en stock" de la nada; sólo tiene sentido
  // activarlo en equipamiento físico (cámaras, sensores, paneles), nunca en
  // Service (abonos de facturación recurrente — modelo totalmente separado).
  trackStock     Boolean           @default(false)
  stock          Int               @default(0)
  movimientos    StockMovimiento[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([organizationId])
}

// Ledger de ajustes manuales de stock — cada fila es un movimiento
// (Entrada/Salida/Ajuste) con el stock resultante como snapshot de
// auditoría, mismo criterio de "guardar el estado post-cambio" que ya usa
// TurnoAsistencia. cantidad siempre positivo; el signo lo da `tipo`.
model StockMovimiento {
  id              String       @id @default(cuid())
  productId       String
  product         Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Lista curada en src/lib/stock.ts — 'Entrada' | 'Salida' | 'Ajuste'.
  // String en vez de enum de Prisma, mismo patrón que ETIQUETAS_TURNO en
  // src/lib/asistencia-turnos.ts y CONDICIONES_IVA en src/lib/fiscal.ts.
  tipo            String
  cantidad        Int
  stockResultante Int
  motivo          String?
  creadoPorId     String?
  createdAt       DateTime     @default(now())

  @@index([organizationId, productId, createdAt])
}

// Uso real de la Barra Rápida móvil (src/components/layout/mobile-quick-bar.tsx)
// — v1 era un set fijo por rol; esto es lo que permite que se ajuste sola a
// lo que cada persona usa de verdad (src/lib/quick-actions.ts hace el
// ranking). actionKey es una clave estable ('fichar','clientes','pipeline',
// etc.), no la pantalla completa — varias pantallas pueden compartir
// relevancia sin que cada una necesite su propia fila.
model QuickActionUsage {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actionKey      String
  count          Int          @default(1)
  lastUsedAt     DateTime     @default(now())
  createdAt      DateTime     @default(now())

  @@unique([userId, actionKey])
  @@index([organizationId, userId])
}

// ─── Historial de Cotizaciones ────────────────────────────────────────────
model Cotizacion {
  id             String           @id @default(cuid())
  ref            String
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User             @relation(fields: [userId], references: [id])
  empresaId      String?
  empresa        Empresa?         @relation(fields: [empresaId], references: [id], onDelete: SetNull)
  // Vínculo estructurado a la oportunidad de Pipeline que originó (o recibió)
  // esta cotización — antes solo existía como texto libre en Deal.notes.
  dealId         String?
  deal           Deal?            @relation(fields: [dealId], references: [id], onDelete: SetNull)
  recipientEmail String
  recipientName  String
  items          Json
  total          Float
  discount       Float            @default(0)
  finalTotal     Float            @default(0)
  currency       String           @default("USD")
  notes          String?
  validityDays   Int              @default(30)
  status         CotizacionStatus @default(ENVIADA)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([organizationId])
  @@index([empresaId])
  @@index([userId])
  @@index([dealId])
}

// ─── Módulo RRHH: Asistencia ──────────────────────────────────────────────
model Asistencia {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fecha          DateTime     @db.Date
  horaEntrada    DateTime?
  horaSalida     DateTime?
  ausente        Boolean      @default(false)
  tardanza       Boolean      @default(false)
  observaciones  String?
  creadoPorId    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([userId, fecha, organizationId])
  @@index([organizationId])
  @@index([userId])
  @@index([fecha])
  // Compuestos: GET /api/asistencia y el cron attendance-digest siempre
  // filtran por organización/usuario + rango de fecha juntos, nunca por
  // fecha sola — los índices de una sola columna de arriba obligan a un
  // bitmap AND en vez de un solo index scan. Mismo criterio que ya se usó
  // para TurnoAsistencia (construida después, en la misma sesión).
  @@index([organizationId, fecha])
  @@index([userId, fecha])
}

// Log real de accesos al CRM — independiente del fichaje (Asistencia, que es
// un botón que el empleado puede simplemente no tocar). Se escribe server-side
// en el momento exacto de un login/logout exitoso (no client-side, para que
// no se pueda falsear) — ver POST /api/auth/log-login y /api/auth/logout.
// Pedido real: "el dueño quiere saber cuándo entra y sale cada usuario, por
// si le dicen 'no fiché'" — esto es la respuesta objetiva a esa pregunta,
// visible desde RRHH → ficha del empleado.
model LoginEvent {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           String // 'LOGIN' | 'LOGOUT'
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, userId, createdAt])
}

// Bug real reportado (2026-08-21, Gabriel Guias): "Asistencia" sólo admite
// UN par entrada/salida por día calendario (@@unique([userId, fecha,
// organizationId])) — Abba confirmó que HAY personas que hacen "extras" o
// "adicionales" (más de una guardia el mismo día). En vez de rediseñar
// Asistencia (usado en RRHH, Mi Asistencia, el widget del header, el cron
// de digest, el % de presentismo — tocar todo eso es mucho más riesgo), se
// suma este modelo aparte, puramente aditivo: cada turno extra es su
// propia fila, sin unique por día (una persona puede hacer más de un
// extra el mismo día). No participa del cálculo de tardanza/ausente/
// presentismo — son horas de más, no el turno regular.
// Fichaje multi-bloque (2026-08-21) — pedido real de Sergio/RRHH tras un bug
// real: Asistencia sólo admite UNA entrada y UNA salida por día calendario
// (@@unique([userId, fecha, organizationId])), lo que rompe turnos que
// cruzan la medianoche y "extras"/adicionales el mismo día. Asistencia NO
// se toca ni se deprecia — sigue siendo la fuente de ausente/tardanza/
// presentismo/cron de avisos, alimentada por mirrorAsistencia() sólo desde
// el bloque "principal" del día (ver src/lib/asistencia-turnos.ts). Este
// modelo reemplaza un intento previo ("TurnoAdicional") que nunca llegó a
// pushearse a ninguna DB real — completar/expandir esto no es una
// migración de datos existentes.
model TurnoAsistencia {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Jornada del bloque — SIEMPRE el día argentino de horaEntrada (nunca de
  // horaSalida), vía argentinaDayStart. "Entrada martes 16:00, salida
  // miércoles 00:00" pertenece a la jornada del martes, sin cortarse.
  fecha          DateTime     @db.Date
  horaEntrada    DateTime?
  horaSalida     DateTime?
  // Listas curadas en src/lib/asistencia-turnos.ts (string, no enum de
  // Prisma) — mismo criterio ya usado en src/lib/fiscal.ts para
  // condicionIva/formaPagoHabitual: Sergio filtra sobre un set chico y
  // puede necesitar ajustarlo sin pedir una migración.
  modalidad      String       @default("Presencial")
  etiqueta       String       @default("Regular")
  // true = el bloque "principal" del día — espeja hacia Asistencia
  // (mantiene 100% el comportamiento actual de "un solo turno"). Se decide
  // UNA vez al crear el bloque (el primero abierto ese día), nunca se
  // recalcula después.
  esPrincipal    Boolean      @default(true)
  tardanza       Boolean      @default(false)
  observaciones  String?
  creadoPorId    String?
  editadoPorId   String?
  // GPS opcional capturado por el navegador al fichar (Geolocation API) —
  // nunca bloquea el fichaje si el usuario no da permiso o el navegador no
  // lo soporta, por eso son nullable. Ver "Ver ubicación" en /rrhh/turnos.
  latEntrada     Float?
  lngEntrada     Float?
  latSalida      Float?
  lngSalida      Float?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, userId, fecha])
  @@index([userId, horaSalida])
  @@index([organizationId, etiqueta])
}

// ─── Idempotencia de cron ──────────────────────────────────────────────────
// Antes de mandar un digest (attendance-digest, task-reminders), cada cron
// intenta crear una fila acá para el (job, org, día) que le toca. Si ya
// existe — choca contra el @@unique de abajo — significa que ya corrió para
// eso y no se manda nada de nuevo, aunque Vercel reintente la invocación.
// Sin relación formal a Organization a propósito: es tracking operativo
// descartable, no dato de negocio — no necesita cascada ni back-relation.
model CronRun {
  id        String   @id @default(cuid())
  jobName   String
  orgId     String
  forDate   DateTime @db.Date
  createdAt DateTime @default(now())

  @@unique([jobName, orgId, forDate])
}

// ─── Rate limiting de formularios públicos ─────────────────────────────────
// Una fila por intento (se crea SIEMPRE al recibir el request, incluso si
// después se rechaza por validación o honeypot) — antes de aceptar un envío
// se cuenta cuántos hubo del mismo `identifier` (IP) en la ventana de
// tiempo. Mismo criterio que CronRun: tracking descartable, sin relaciones.
model PublicFormAttempt {
  id         String   @id @default(cuid())
  kind       String // ej. "ticket_public"
  identifier String // IP del request (x-forwarded-for)
  createdAt  DateTime @default(now())

  @@index([kind, identifier, createdAt])
}

// ─── Plugin Google Calendar ─────────────────────────────────────────────
// Tokens OAuth de la cuenta de Google que conectó la organización (una
// sola por org, quien la conectó queda en connectedById sólo a modo de
// referencia). Sin relación a Organization/User a propósito — mismo
// criterio "superficie mínima" que CronRun/PublicFormAttempt.
model GoogleCalendarConnection {
  id             String   @id @default(cuid())
  organizationId String   @unique
  connectedById  String
  accessToken    String
  refreshToken   String
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
